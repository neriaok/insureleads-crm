# Copy this file to .env and fill in your own values.
# .env is ignored by git and must never be committed.

# PostgreSQL (used by docker-compose)
POSTGRES_USER=insureleads
POSTGRES_PASSWORD=change_me
POSTGRES_DB=insureleads
POSTGRES_PORT=5432

# Server
PORT=4000
POSTGRES_HOST=localhost

# Auth (generate a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_me_to_a_long_random_string

# Cache (optional: without it the API works, just without caching)
REDIS_URL=redis://localhost:6379

# Hosted PostgreSQL (e.g. Neon): when set, it replaces the POSTGRES_* connection settings above
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Daily renewal job (Vercel Cron sends it as a Bearer token). Optional locally: use npm run renewals instead.
# CRON_SECRET=change_me_to_a_long_random_string
